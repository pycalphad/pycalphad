$ Fictitious database with one two-sublattice ionic liquid phase for each kind
$ of interaction without anions in B. Sundman, Calphad 15(2) (1991) 109-119,
$ as listed in pycalphad gh-647. All endmember energies are zero.
$ Each phase X is followed by its equivalent regular solution X_RS.

ELEMENT /-   ELECTRON_GAS              0.0          0.0      0.0    !
ELEMENT VA   VACUUM                    0.0          0.0      0.0    !
ELEMENT AL   FCC_A1                   26.982        0.0      0.0    !
ELEMENT C    GRAPHITE                 12.011        0.0      0.0    !
ELEMENT CA   FCC_A1                   40.078        0.0      0.0    !
ELEMENT N    1/2_MOLE_N2(G)           14.007        0.0      0.0    !
ELEMENT NA   BCC_A2                   22.990        0.0      0.0    !
ELEMENT SI   DIAMOND_A4               28.085        0.0      0.0    !

SPECIES AL+3 AL1/+3 !
SPECIES CA+2 CA1/+2 !
SPECIES NA+1 NA1/+1 !

DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !
TYPE_DEFINITION % SEQ * !

$ Binary cation-neutral with Redlich-Kister terms
PHASE CAT_NEU:Y % 2 1 1 !
CONSTITUENT CAT_NEU:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_NEU,AL+3:VA,C;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_NEU,AL+3:VA,C;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_NEU,AL+3:VA,C;2) 298.15 3000; 6000 N !

PHASE CAT_NEU_RS % 1 1 !
CONSTITUENT CAT_NEU_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_NEU_RS,AL,C;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_NEU_RS,AL,C;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_NEU_RS,AL,C;2) 298.15 3000; 6000 N !

$ Composition independent ternaries
PHASE CAT_CAT_CAT:Y % 2 1 1 !
CONSTITUENT CAT_CAT_CAT:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_CAT_CAT,AL+3,CA+2,NA+1:VA;0) 298.15 10000; 6000 N !

PHASE CAT_CAT_CAT_RS % 1 1 !
CONSTITUENT CAT_CAT_CAT_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_CAT_CAT_RS,AL,CA,NA;0) 298.15 10000; 6000 N !

PHASE CAT_CAT_NEU:Y % 2 1 1 !
CONSTITUENT CAT_CAT_NEU:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_CAT_NEU,AL+3,CA+2:VA,C;0) 298.15 10000; 6000 N !

PHASE CAT_CAT_NEU_RS % 1 1 !
CONSTITUENT CAT_CAT_NEU_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_CAT_NEU_RS,AL,C,CA;0) 298.15 10000; 6000 N !

PHASE CAT_NEU_NEU:Y % 2 1 1 !
CONSTITUENT CAT_NEU_NEU:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_NEU_NEU,AL+3:VA,C,SI;0) 298.15 10000; 6000 N !

PHASE CAT_NEU_NEU_RS % 1 1 !
CONSTITUENT CAT_NEU_NEU_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_NEU_NEU_RS,AL,C,SI;0) 298.15 10000; 6000 N !

PHASE NEU_NEU_NEU:Y % 2 1 1 !
CONSTITUENT NEU_NEU_NEU:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(NEU_NEU_NEU,C,N,SI;0) 298.15 10000; 6000 N !

PHASE NEU_NEU_NEU_RS % 1 1 !
CONSTITUENT NEU_NEU_NEU_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(NEU_NEU_NEU_RS,C,N,SI;0) 298.15 10000; 6000 N !

$ Composition dependent ternaries
PHASE CAT_CAT_CAT_DEP:Y % 2 1 1 !
CONSTITUENT CAT_CAT_CAT_DEP:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_CAT_CAT_DEP,AL+3,CA+2,NA+1:VA;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_CAT_CAT_DEP,AL+3,CA+2,NA+1:VA;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_CAT_CAT_DEP,AL+3,CA+2,NA+1:VA;2) 298.15 3000; 6000 N !

PHASE CAT_CAT_CAT_DEP_RS % 1 1 !
CONSTITUENT CAT_CAT_CAT_DEP_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_CAT_CAT_DEP_RS,AL,CA,NA;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_CAT_CAT_DEP_RS,AL,CA,NA;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_CAT_CAT_DEP_RS,AL,CA,NA;2) 298.15 3000; 6000 N !

PHASE CAT_CAT_NEU_DEP:Y % 2 1 1 !
CONSTITUENT CAT_CAT_NEU_DEP:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_CAT_NEU_DEP,AL+3,CA+2:VA,C;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_CAT_NEU_DEP,AL+3,CA+2:VA,C;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_CAT_NEU_DEP,AL+3,CA+2:VA,C;2) 298.15 3000; 6000 N !

$ Orders 1 and 2 swapped: AL,C,CA sorts differently than AL+3,CA+2,C
PHASE CAT_CAT_NEU_DEP_RS % 1 1 !
CONSTITUENT CAT_CAT_NEU_DEP_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_CAT_NEU_DEP_RS,AL,C,CA;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_CAT_NEU_DEP_RS,AL,C,CA;1) 298.15 3000; 6000 N !
PARAMETER L(CAT_CAT_NEU_DEP_RS,AL,C,CA;2) 298.15 -7000; 6000 N !

PHASE CAT_NEU_NEU_DEP:Y % 2 1 1 !
CONSTITUENT CAT_NEU_NEU_DEP:Y :AL+3,CA+2,NA+1:VA,C,N,SI: !
PARAMETER L(CAT_NEU_NEU_DEP,AL+3:VA,C,SI;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_NEU_NEU_DEP,AL+3:VA,C,SI;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_NEU_NEU_DEP,AL+3:VA,C,SI;2) 298.15 3000; 6000 N !

PHASE CAT_NEU_NEU_DEP_RS % 1 1 !
CONSTITUENT CAT_NEU_NEU_DEP_RS :AL,CA,NA,C,N,SI: !
PARAMETER L(CAT_NEU_NEU_DEP_RS,AL,C,SI;0) 298.15 10000; 6000 N !
PARAMETER L(CAT_NEU_NEU_DEP_RS,AL,C,SI;1) 298.15 -7000; 6000 N !
PARAMETER L(CAT_NEU_NEU_DEP_RS,AL,C,SI;2) 298.15 3000; 6000 N !
