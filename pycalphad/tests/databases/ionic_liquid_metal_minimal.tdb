$ database triggers a 2SL ionic liquid convergence failure for mixed-valence
$ cations with an odd-order Redlich-Kister interaction term.
$
$ Contains the Hf-Nb parameters from
$ G. Ghosh, A. van de Walle, M. Asta, G.B. Olson, Calphad, 26, 491-511(2002).
$ with liquid converted to an ionic liquid and LIQUID_SUBS used to retain the
$ metallic only liquid

ELEMENT /-   ELECTRON_GAS              0.0          0.0      0.0    !
ELEMENT VA   VACUUM                    0.0          0.0      0.0    !
ELEMENT HF   HCP_A3                  178.49      5845.0     43.56   !
ELEMENT NB   BCC_A2                   92.9064    5220.0     36.27   !

SPECIES HF+4 HF1.0/+4 !
SPECIES NB+2 NB1.0/+2 !

FUNCTION GHSERHF 298.15 -6987.297-22590.0*T**(-1)-22.7075*T*LOG(T)
  -0.004146145*T**(2)+110.744026*T-4.77E-10*T**(3); 2506.0 Y -1446776.329
  +501742495.0*T**(-1)-787.5363829*T*LOG(T)+0.1735215*T**(2)+6193.609991*T
  -7.575759E-06*T**(3); 3000.0 Y -34274.698-44.0*T*LOG(T)+277.882368*T;
   3001.0 N !
FUNCTION GHSERNB 298.15 -8519.353+93399.0*T**(-1)-26.4711*T*LOG(T)
  +0.000203475*T**(2)+142.045475*T-3.5012E-07*T**(3); 2750.0 Y -37669.3
  -41.77*T*LOG(T)+1.528238E+32*T**(-9)+271.720843*T; 6000.0 N !
FUNCTION GLIQHF 298.15 27402.256+GHSERHF-10.953093*T; 1000.0 Y 49731.499
  -4449699.0*T**(-1)+12.116812*T*LOG(T)-0.021262021*T**(2)-149.91739*T
  +1.376466E-06*T**(3); 2506.0 Y -4247.217-44.0*T*LOG(T)+265.470523*T; 3001.0
   N !
FUNCTION GLIQNB 298.15 29781.555-10.816418*T-3.06098E-23*T**(7)+GHSERNB;
   2750.0 Y -7499.398-41.77*T*LOG(T)+260.756148*T; 6000.0 N !

TYPE_DEFINITION % SEQ * !

PHASE LIQUID:Y %  2 1.0 1.0 !
CONSTITUENT LIQUID:Y :HF+4, NB+2:VA: !

PARAMETER G(LIQUID,HF+4:VA;0) 0.01 GLIQHF; 3001.0 N !
PARAMETER G(LIQUID,NB+2:VA;0) 0.01 GLIQNB; 6000.0 N !
PARAMETER L(LIQUID,HF+4,NB+2:VA;0) 0.01 20430.77; 6000.0 N !
PARAMETER L(LIQUID,HF+4,NB+2:VA;1) 0.01 12945.54; 6000.0 N !

PHASE LIQUID_SUBS %  1 1.0 !
CONSTITUENT LIQUID_SUBS :HF, NB: !

PARAMETER G(LIQUID_SUBS,HF;0) 0.01 GLIQHF; 3001.0 N !
PARAMETER G(LIQUID_SUBS,NB;0) 0.01 GLIQNB; 6000.0 N !
PARAMETER L(LIQUID_SUBS,HF,NB;0) 0.01 20430.77; 6000.0 N !
PARAMETER L(LIQUID_SUBS,HF,NB;1) 0.01 12945.54; 6000.0 N !
